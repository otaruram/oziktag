// ============================================================
// Oziktag Database Schema (Prisma + Supabase PostgreSQL)
// ============================================================

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  enable_experimental_decimal = true
  engineType           = "binary"
  binaryTargets        = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────── Users ────────────────────────
model User {
  id         String    @id @default(uuid())
  nama       String    @default("")
  email      String    @unique
  sisaKredit Int       @default(0) @map("sisa_kredit")
  apiKredit  Int       @default(0) @map("api_kredit")
  escrowBalance Int    @default(0) @map("escrow_balance")
  isAdmin    Boolean   @default(false) @map("is_admin")
  hasApiAccess Boolean @default(false) @map("has_api_access")
  isBanned   Boolean   @default(false) @map("is_banned")
  isElite    Boolean   @default(false) @map("is_elite")
  eliteExpiresAt DateTime? @map("elite_expires_at")
  creditScoreRequested Boolean @default(false) @map("credit_score_requested")
  canViewCreditScore   Boolean @default(false) @map("can_view_credit_score")
  escrowRequested      Boolean @default(false) @map("escrow_requested")
  canUseEscrow         Boolean @default(false) @map("can_use_escrow")
  receivesPromoEmails  Boolean @default(false) @map("receives_promo_emails")
  lastSeenAt DateTime? @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  kyc                Kyc?
  qcProducts         QcProduct[]
  topupTransactions  TopupTransaction[]
  productScans       ProductScan[]
  apiKeys            ApiKey[]
  creditLogs         CreditLog[]
  escrowRequest      EscrowRequest?
  apiAccessRequests  ApiAccessRequest[]
  trackingProducts   TrackingProduct[]
  withdrawRequests   WithdrawRequest[]

  @@map("users")
}

// ──────────────────────── API Keys ────────────────────────
model ApiKey {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String   @unique
  name      String   @default("Production Key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// "?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"? API Access Requests "?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?"?
model ApiAccessRequest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_access_requests")
}

// ──────────────────────── KYC ────────────────────────
model Kyc {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  namaToko        String   @default("") @map("nama_toko")
  nik             String   @unique
  npwp            String?  @unique
  fotoKtp         String?  @map("foto_ktp")
  fotoNpwp        String?  @map("foto_npwp")
  website         String?
  fotoProduk1     String?  @map("foto_produk_1")
  fotoProduk2     String?  @map("foto_produk_2")
  deskripsiProduk String?  @map("deskripsi_produk")
  status          String   @default("verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc")
}

// ──────────────────────── QC Products ────────────────────────
model QcProduct {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  namaProduk     String   @map("nama_produk")
  kategori       String   @default("Lainnya")
  batch          String?
  checklist      Json     @default("[]")
  catatanPenjual String?  @map("catatan_penjual")
  hargaProduksi  Int?     @map("harga_produksi")
  hargaJual      Int?     @map("harga_jual")
  aiInsight      String?  @map("ai_insight")
  aiSolution     String?  @map("ai_solution")
  createdAt      DateTime @default(now()) @map("created_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ProductImage[]
  scans  ProductScan[]

  @@map("qc_products")
}

// ──────────────────────── Product Images ────────────────────────
model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  imagekitUrl String   @map("imagekit_url")
  createdAt   DateTime @default(now()) @map("created_at")

  product QcProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ──────────────────────── Top-Up Transactions ────────────────────────
model TopupTransaction {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  paket               String
  tipeKredit          String   @default("QR") @map("tipe_kredit")
  amount              Int
  credits             Int      @default(0)
  status              String   @default("pending")
  sumopodRef           String?  @map("sumopod_ref")
  sumopodTransactionId String?  @map("sumopod_transaction_id")
  paymentType         String?  @map("payment_type")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("topup_transactions")
}

// ──────────────────────── Product Scans ────────────────────────
model ProductScan {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  scannedAt DateTime @default(now()) @map("scanned_at")

  product QcProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_scans")
}

// ──────────────────────── Credit Logs ────────────────────────
model CreditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tipeKredit  String   @default("QR") @map("tipe_kredit") // "QR" or "API"
  action      String   // "TOPUP", "USAGE", "REFUND"
  amount      Int      // +100 or -1
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_logs")
}

// ──────────────────────── AI Cache ────────────────────────
model AiCache {
  id         String   @id @default(uuid())
  inputHash  String   @unique @map("input_hash")
  insight    String
  solution   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ai_cache")
}

// ──────────────────────── Elite Articles ────────────────────────
model EliteArticle {
  id        String   @id @default(uuid())
  title     String
  preview   String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("elite_articles")
}

// ──────────────────────── Elite Videos ────────────────────────
model EliteVideo {
  id         String   @id @default(uuid())
  title      String
  youtubeUrl String   @map("youtube_url")
  thumbnail  String
  duration   String
  category   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("elite_videos")
}

// ──────────────────────── Tracking Products ────────────────────────
model TrackingProduct {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  name           String
  buyerPin       String   @default("000000") @map("buyer_pin")
  checklistQc    Json     @default("[]") @map("checklist_qc")
  sellerNotes    String?  @map("seller_notes") @db.Text
  aiSummary      String?  @map("ai_summary") @db.Text
  imageUrl       String?  @map("image_url")
  currentStatus  String   @default("PACKED") @map("current_status")
  isHiddenBySeller Boolean @default(false) @map("is_hidden_by_seller")
  
  // Escrow Fields
  isEscrow       Boolean  @default(false) @map("is_escrow")
  price          Int      @default(0)
  escrowFee      Int      @default(0) @map("escrow_fee")
  netAmount      Int      @default(0) @map("net_amount")
  sumopodRef     String?  @map("sumopod_ref")
  paymentUrl     String?  @map("payment_url")
  youtubeUrl     String?  @map("youtube_url")
  
  escrowStatus   String   @default("HELD") @map("escrow_status")
  deliveredAt    DateTime? @map("delivered_at")
  payoutReleasedAt DateTime? @map("payout_released_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  history TrackingHistory[]
  disputeTicket DisputeTicket?

  @@map("tracking_products")
}

// ──────────────────────── Withdraw Requests ────────────────────────
model WithdrawRequest {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  amount        Int
  bankName      String   @map("bank_name")
  bankAccount   String   @map("bank_account")
  accountName   String   @map("account_name")
  status        String   @default("pending") // pending, completed, rejected
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdraw_requests")
}

// ──────────────────────── Tracking History ────────────────────────
model TrackingHistory {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  statusUpdate  String   @map("status_update")
  scannedByRole String   @map("scanned_by_role")
  latitude      Float?
  longitude     Float?
  timestamp     DateTime @default(now())

  product TrackingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tracking_history")
}
// ──────────────────────── Escrow Request ────────────────────────
model EscrowRequest {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  namaBank       String   @map("nama_bank")
  nomorRekening  String   @map("nomor_rekening")
  namaPemilik    String   @map("nama_pemilik")
  linkUmkm       String?  @map("link_umkm")
  catatanProduk  String?  @map("catatan_produk")
  tujuanEscrow   String?  @map("tujuan_escrow")
  status         String   @default("pending") // pending, approved, rejected
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("escrow_requests")
}

// ──────────────────────── Dispute Ticket ────────────────────────
model DisputeTicket {
  id                String   @id @default(uuid())
  trackingProductId String   @unique @map("tracking_product_id")
  buyerEmail        String   @map("buyer_email")
  buyerPhone        String?  @map("buyer_phone")
  reason            String   @db.Text
  videoUrl          String?  @map("video_url")
  status            String   @default("OPEN") // OPEN, RESOLVED_REFUND, RESOLVED_RELEASE, REJECTED
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product TrackingProduct @relation(fields: [trackingProductId], references: [id], onDelete: Cascade)

  @@map("dispute_tickets")
}

// ============================================================
// Event Ticketing, Seat Map & Escrow Auto-Settlement (Oziktag x Summarecon Mall Bandung)
// ============================================================
enum SeatCategory {
  VIP
  REGULAR
  WING
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum CheckInStatus {
  UNUSED
  USED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

model Event {
  id          String   @id @default(uuid())
  organizerId String?  @map("organizer_id")
  title       String
  venue       String
  date        String
  categories  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  seats       Seat[]

  @@index([organizerId])
  @@map("events")
}

model Seat {
  id            String       @id @default(uuid())
  eventId       String?      @map("event_id")
  seatCode      String       @unique @map("seat_code") // e.g. "A-01" or "VIP-A1"
  rowLabel      String       @map("row_label")
  colNumber     Int          @map("col_number")
  category      SeatCategory @default(REGULAR)
  price         Decimal      @db.Decimal(12, 2)
  status        SeatStatus   @default(AVAILABLE)

  // 5-minute TTL hold. Only a SHA-256 hash of the hold token is stored (never plaintext).
  reservedUntil DateTime?    @map("reserved_until")
  holdTokenHash String?      @map("hold_token_hash")
  heldByUserId  String?      @map("held_by_user_id")

  buyerName     String?      @map("buyer_name")
  buyerContact  String?      @map("buyer_contact")
  buyerEmail    String?      @map("buyer_email")

  // SHA-256 of the HMAC signature embedded in the QR (binds DB row to the issued pass).
  ticketHash    String?      @map("ticket_hash")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  event         Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  transactions  TicketTransaction[]

  @@index([eventId])
  @@index([status, reservedUntil])
  @@index([heldByUserId])
  @@map("event_seats")
}

model TicketTransaction {
  id               String        @id @default(uuid())
  seatId           String        @map("seat_id")
  userId           String?       @map("user_id")
  buyerId          String?       @map("buyer_id")
  organizerId      String?       @map("organizer_id")
  amount           Decimal       @db.Decimal(12, 2)
  escrowFee        Decimal       @default(0) @db.Decimal(12, 2) @map("escrow_fee")
  netAmount        Decimal       @default(0) @db.Decimal(12, 2) @map("net_amount")
  paymentMethod    String        @default("SIMULATED") @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  checkInStatus    CheckInStatus @default(UNUSED) @map("check_in_status")
  escrowStatus     EscrowStatus  @default(HELD) @map("escrow_status")
  checkedInAt      DateTime?     @map("checked_in_at")
  checkedInGate    String?       @map("checked_in_gate")
  escrowReleasedAt DateTime?     @map("escrow_released_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([seatId])
  @@index([checkInStatus])
  @@index([escrowStatus])
  @@index([organizerId])
  @@map("ticket_transactions")
}
