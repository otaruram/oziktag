# Oziktag Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Supabase Auth ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
SUPABASE_CALLBACK_URL=https://xxxx.supabase.co/auth/v1/callback

# --- Database (Prisma) ---
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres

# --- ImageKit ---
IMAGEKIT_PRIVATE_KEY=private_xxxx
IMAGEKIT_PUBLIC_KEY=public_xxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# --- Louvin Payment Gateway ---
LOUVIN_API_KEY=lv_xxxx
LOUVIN_BASE_URL=https://api.louvin.dev

# --- Google Gemini AI ---
GEMINI_API_KEY=AIza...
GEMINI_BASE_URL=https://ai.sumopod.com
GEMINI_MODEL=gemini/gemini-2.5-flash-lite

# --- Admin ---
ADMIN_EMAIL=okitr52@gmail.com

# --- Pricing (Exchange Rate & Buffer) ---
EXCHANGE_RATE=17000
PRICE_BUFFER_PERCENT=25

# --- SMTP Email ---
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=support@oziktag.my.id
SMTP_FROM_NAME=Oziktag

# --- App ---
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:8000
